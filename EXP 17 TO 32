# Program 21: Floating-point precision errors across numerical data types

import numpy as np
from fractions import Fraction

def exact_sum_of_tenths(n):
    return Fraction(1, 10) * n

print("Summing 0.1 repeatedly (exact value = n/10):")
print(f"{'n':>10} {'float16':>14} {'float32':>14} {'float64':>14} {'exact':>14}")
for n in [10, 1000, 100000]:
    s16 = np.float16(0)
    s32 = np.float32(0)
    s64 = np.float64(0)
    for _ in range(n):
        s16 = np.float16(s16 + np.float16(0.1))
        s32 = np.float32(s32 + np.float32(0.1))
        s64 = np.float64(s64 + np.float64(0.1))
    exact = float(exact_sum_of_tenths(n))
    print(f"{n:>10} {float(s16):>14.4f} {float(s32):>14.4f} {float(s64):>14.6f} {exact:>14.6f}")

print("\nRelative error of each type after 100000 additions of 0.1:")
exact = 100000 / 10
for dtype in (np.float16, np.float32, np.float64):
    total = dtype(0)
    step = dtype(0.1)
    for _ in range(100000):
        total = dtype(total + step)
    err = abs(float(total) - exact) / exact
    print(f"{dtype.__name__:>10}: total = {float(total):.6f}, relative error = {err:.2e}")

print("\nCatastrophic cancellation: (1 + x) - 1 for small x")
for x in [1e-8, 1e-12, 1e-16]:
    for dtype in (np.float32, np.float64):
        xv = dtype(x)
        computed = (dtype(1) + xv) - dtype(1)
        rel = abs(float(computed) - x) / x
        print(f"x = {x:.0e}, {dtype.__name__}: computed = {float(computed):.3e}, relative error = {rel:.2e}")

print("\nOverflow and underflow limits:")
for dtype in (np.float16, np.float32, np.float64):
    info = np.finfo(dtype)
    print(f"{dtype.__name__:>8}: max = {info.max:.3e}, smallest normal = {info.tiny:.3e}, "
          f"machine epsilon = {info.eps:.3e}")

print("\nOverflow demonstration:")
big = np.float16(60000)
print("float16 60000 * 2 =", big * np.float16(2), "(overflows to inf)")
print("float64 60000 * 2 =", np.float64(60000) * 2)

print("\nUnderflow demonstration:")
tiny = np.float16(1e-5)
print("float16 product of tiny values 1e-5 * 1e-5 =", tiny * tiny)
print("float64 product of same values =", np.float64(1e-5) * np.float64(1e-5))

print("\nLarge and small mixed sum (order of addition matters):")
values = [1e16, 1.0, -1e16]
print("(1e16 + 1) - 1e16 in float64 =", (values[0] + values[1]) + values[2])
print("1e16 + (1 - 1e16) in float64 =", values[0] + (values[1] + values[2]))
print("Exact result is 1.0 when computed as Fraction:",
      float(Fraction(10**16) + Fraction(1) - Fraction(10**16)))

print("\nConclusion: float16 accumulates large error quickly and overflows past 65504;")
print("float32 is adequate for many tasks but loses precision at large magnitudes;")
print("float64 has about 16 significant decimal digits and is the default for scientific work.")
     
