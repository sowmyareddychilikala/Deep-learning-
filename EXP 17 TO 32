# Program 32: Binary cross-entropy neural network for fraud detection

import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import make_classification
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import (confusion_matrix, precision_score, recall_score,
                             f1_score, roc_auc_score, log_loss, precision_recall_curve)
from tensorflow import keras
from tensorflow.keras import layers

X, y = make_classification(n_samples=5000, n_features=12, n_informative=6,
                           n_redundant=2, weights=[0.95, 0.05], flip_y=0.01,
                           random_state=32)

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2,
                                                    stratify=y, random_state=32)
X_fit, X_val, y_fit, y_val = train_test_split(X_train, y_train, test_size=0.25,
                                              stratify=y_train, random_state=32)

scaler = StandardScaler().fit(X_fit)
Xf = scaler.transform(X_fit)
Xv = scaler.transform(X_val)
Xte = scaler.transform(X_test)

keras.utils.set_random_seed(32)
model = keras.Sequential([
    layers.Input(shape=(X.shape[1],)),
    layers.Dense(32, activation="relu"),
    layers.Dropout(0.2),
    layers.Dense(16, activation="relu"),
    layers.Dense(1, activation="sigmoid"),
])
model.compile(optimizer=keras.optimizers.Adam(learning_rate=0.001),
              loss="binary_crossentropy",
              metrics=[keras.metrics.AUC(name="auc")])

n_pos = y_fit.sum()
n_neg = len(y_fit) - n_pos
class_weight = {0: 1.0, 1: n_neg / n_pos}

early = keras.callbacks.EarlyStopping(monitor="val_loss", patience=15,
                                      restore_best_weights=True)
history = model.fit(Xf, y_fit, validation_data=(Xv, y_val), epochs=300,
                    batch_size=64, class_weight=class_weight,
                    callbacks=[early], verbose=0)

print("Epochs run:", len(history.history["loss"]))
print("Final training loss:", round(history.history["loss"][-1], 4))
print("Best validation loss:", round(min(history.history["val_loss"]), 4))

p_val = model.predict(Xv, verbose=0).ravel()
precision, recall, thresholds = precision_recall_curve(y_val, p_val)
f1_curve = 2 * precision * recall / np.maximum(precision + recall, 1e-12)
best_idx = np.argmax(f1_curve[:-1])
threshold = thresholds[best_idx]
print("Threshold chosen on validation data (maximises F1):", round(threshold, 4))

p_test = model.predict(Xte, verbose=0).ravel()
y_pred = (p_test >= threshold).astype(int)

print("Test binary cross-entropy (log loss):", round(log_loss(y_test, p_test), 4))
print("Test ROC-AUC:", round(roc_auc_score(y_test, p_test), 4))
print("Test precision (fraud):", round(precision_score(y_test, y_pred), 4))
print("Test recall (fraud):", round(recall_score(y_test, y_pred), 4))
print("Test F1-score (fraud):", round(f1_score(y_test, y_pred), 4))

tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()
print("Confusion matrix (test):")
print("              Predicted legit  Predicted fraud")
print(f"Actual legit  {tn:>15}  {fp:>15}")
print(f"Actual fraud  {fn:>15}  {tp:>15}")

print("Accuracy on test (reference only):", round((tp + tn) / len(y_test), 4))
print("Accuracy alone can look high on imbalanced data;")
print("precision, recall and F1 for the fraud class are the meaningful measures.")

fig, axes = plt.subplots(1, 2, figsize=(12, 4.5))
axes[0].plot(history.history["loss"], label="Training loss")
axes[0].plot(history.history["val_loss"], label="Validation loss")
axes[0].set_xlabel("Epoch")
axes[0].set_ylabel("Binary cross-entropy")
axes[0].set_title("Training history")
axes[0].legend()
axes[0].grid(True)

axes[1].plot(recall, precision)
axes[1].set_xlabel("Recall (fraud)")
axes[1].set_ylabel("Precision (fraud)")
axes[1].set_title("Precision-recall curve (validation)")
axes[1].grid(True)
plt.tight_layout()
plt.show()
     
