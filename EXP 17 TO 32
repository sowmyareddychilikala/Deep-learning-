
# Program 17: Overfitting analysis for a neural network predicting exam performance

import copy
import warnings
import numpy as np
import matplotlib.pyplot as plt
from sklearn.neural_network import MLPClassifier
from sklearn.datasets import make_classification
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

warnings.filterwarnings("ignore", category=UserWarning)

X, y = make_classification(n_samples=300, n_features=20, n_informative=5,
                           n_redundant=2, flip_y=0.1, random_state=7)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=7)
X_fit, X_val, y_fit, y_val = train_test_split(X_train, y_train, test_size=0.25, random_state=7)

model = MLPClassifier(hidden_layer_sizes=(128, 128), activation="relu",
                      max_iter=1, warm_start=True, random_state=7)

epochs = 300
train_acc, val_acc = [], []
best_val, best_epoch, best_model = -1, 0, None
for epoch in range(1, epochs + 1):
    model.fit(X_fit, y_fit)
    tr = accuracy_score(y_fit, model.predict(X_fit))
    va = accuracy_score(y_val, model.predict(X_val))
    train_acc.append(tr)
    val_acc.append(va)
    if va > best_val:
        best_val, best_epoch, best_model = va, epoch, copy.deepcopy(model)

print("Final training accuracy:", round(train_acc[-1], 4))
print("Final validation accuracy:", round(val_acc[-1], 4))
print("Best validation accuracy:", round(best_val, 4), "at epoch", best_epoch)
print("Test accuracy of best-validation model:",
      round(accuracy_score(y_test, best_model.predict(X_test)), 4))
print("Gap (train - validation) at final epoch:", round(train_acc[-1] - val_acc[-1], 4))

if train_acc[-1] - val_acc[-1] > 0.1:
    print("Diagnosis: overfitting (large gap between training and validation accuracy)")
else:
    print("Diagnosis: no major overfitting")

plt.plot(range(1, epochs + 1), train_acc, label="Training accuracy")
plt.plot(range(1, epochs + 1), val_acc, label="Validation accuracy")
plt.axvline(best_epoch, color="gray", linestyle="--", label="Best validation epoch")
plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.title("Training vs validation accuracy")
plt.legend()
plt.grid(True)
plt.show()

best_alpha, best_reg_val, best_reg_model = None, -1, None
print("\nL2 regularization (alpha) search, selected on validation accuracy:")
for alpha in [1e-4, 1e-3, 1e-2, 1e-1, 1.0]:
    reg = MLPClassifier(hidden_layer_sizes=(128, 128), activation="relu",
                        alpha=alpha, max_iter=300, random_state=7)
    reg.fit(X_fit, y_fit)
    tr = accuracy_score(y_fit, reg.predict(X_fit))
    va = accuracy_score(y_val, reg.predict(X_val))
    print(f"alpha={alpha:<7} train={tr:.4f}  validation={va:.4f}")
    if va > best_reg_val:
        best_alpha, best_reg_val, best_reg_model = alpha, va, reg

print("Selected alpha:", best_alpha)
print("Test accuracy of regularized model:",
      round(accuracy_score(y_test, best_reg_model.predict(X_test)), 4))

print("\nSuggested improvements:")
print("1. Add L2 regularization (alpha parameter of MLPClassifier)")
print("2. Use early stopping, selected on a validation split")
print("3. Reduce network size")
print("4. Collect more training data")
     
