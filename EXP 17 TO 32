# Program 23: Reinforcement learning agent for adaptive traffic signal control

import numpy as np
import matplotlib.pyplot as plt

MAX_Q = 10
EPISODE_LEN = 200
SATURATION = 3

class TrafficEnv:
    def __init__(self, arrival_ns=0.35, arrival_ew=0.30, seed=0):
        self.arrival = {0: arrival_ns, 1: arrival_ew}
        self.rng = np.random.default_rng(seed)

    def reset(self):
        self.q = [0, 0]
        self.green = 0
        self.t = 0
        self.total_wait = 0
        return self._state()

    def _state(self):
        return (min(self.q[0], MAX_Q), min(self.q[1], MAX_Q), self.green)

    def step(self, action):
        lost = False
        if action == 1:
            self.green = 1 - self.green
            lost = True
        for d in (0, 1):
            self.q[d] += self.rng.poisson(self.arrival[d])
        if not lost:
            discharged = min(SATURATION, self.q[self.green])
            self.q[self.green] -= discharged
        waiting = sum(self.q)
        self.total_wait += waiting
        self.t += 1
        done = self.t >= EPISODE_LEN
        return self._state(), -waiting, done

def train(episodes=3000, alpha=0.1, gamma=0.95, eps_start=1.0, eps_end=0.05, seed=1):
    Q = np.zeros((MAX_Q + 1, MAX_Q + 1, 2, 2))
    rng = np.random.default_rng(seed)
    env = TrafficEnv(seed=seed)
    rewards = []
    for ep in range(episodes):
        eps = eps_start + (eps_end - eps_start) * ep / (episodes - 1)
        s = env.reset()
        done = False
        ep_reward = 0
        while not done:
            if rng.random() < eps:
                a = int(rng.integers(2))
            else:
                a = int(np.argmax(Q[s]))
            s2, r, done = env.step(a)
            target = r + (0 if done else gamma * np.max(Q[s2]))
            Q[s][a] += alpha * (target - Q[s][a])
            s = s2
            ep_reward += r
        rewards.append(ep_reward)
    return Q, rewards

def fixed_time_policy(s, env):
    return 1 if env.t > 0 and env.t % 20 == 0 else 0

def queue_rule_policy(s, env):
    current = s[2]
    cur_queue = s[current]
    other_queue = s[1 - current]
    return 1 if other_queue > cur_queue + 2 else 0

def make_rl_policy(Q):
    def policy(s, env):
        return int(np.argmax(Q[s]))
    return policy

def evaluate(policy, episodes=50, base_seed=10000):
    waits = []
    for i in range(episodes):
        env = TrafficEnv(seed=base_seed + i)
        s = env.reset()
        done = False
        while not done:
            a = policy(s, env)
            s, r, done = env.step(a)
        waits.append(env.total_wait)
    return np.mean(waits), np.std(waits)

Q, rewards = train()

print("Training: average episode reward, first 100 episodes =",
      round(np.mean(rewards[:100]), 1))
print("Training: average episode reward, last 100 episodes  =",
      round(np.mean(rewards[-100:]), 1))

rl_policy = make_rl_policy(Q)
results = {
    "Fixed-time (switch every 20 steps)": evaluate(fixed_time_policy),
    "Queue rule (switch if other queue longer)": evaluate(queue_rule_policy),
    "Reinforcement learning (greedy)": evaluate(rl_policy),
}

print(f"\n{'Controller':<44} {'Mean total wait':>16} {'Std':>10}")
for name, (mean_w, std_w) in results.items():
    print(f"{name:<44} {mean_w:>16.1f} {std_w:>10.1f}")

print("\nLearned action when green = North-South (keep = 0, switch = 1):")
levels = [0, 2, 4, 6, 8, 10]
print("q_NS \ q_EW " + " ".join(f"{q:>4}" for q in levels))
for q_ns in levels:
    row = []
    for q_ew in levels:
        row.append(f"{int(np.argmax(Q[(q_ns, q_ew, 0)])):>4}")
    print(f"{q_ns:>11} " + " ".join(row))

plt.figure(figsize=(8, 4))
window = 50
smoothed = np.convolve(rewards, np.ones(window) / window, mode="valid")
plt.plot(smoothed)
plt.xlabel("Training episode")
plt.ylabel("Episode reward (smoothed)")
plt.title("RL agent learning curve")
