# Program 19: L1 and L2 regularization for loan amount prediction

import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import Lasso, Ridge, LinearRegression
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

def rmse(a, b):
    return np.sqrt(mean_squared_error(a, b))

rng = np.random.default_rng(5)
n = 500
income = rng.uniform(20000, 120000, n)
credit_score = rng.uniform(300, 850, n)
existing_debt = rng.uniform(0, 50000, n)
employment_years = rng.uniform(0, 30, n)
age = rng.uniform(21, 70, n)
noise_1 = rng.normal(0, 1, n)
noise_2 = rng.normal(0, 1, n)
loan = (0.4 * income + 120 * credit_score - 0.6 * existing_debt
        + 800 * employment_years + rng.normal(0, 8000, n))

features = ["income", "credit_score", "existing_debt", "employment_years", "age", "noise_1", "noise_2"]
X = np.column_stack([income, credit_score, existing_debt, employment_years, age, noise_1, noise_2])
y = loan

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=5)
X_fit, X_val, y_fit, y_val = train_test_split(X_train, y_train, test_size=0.25, random_state=5)

scaler = StandardScaler().fit(X_fit)
Xf, Xv = scaler.transform(X_fit), scaler.transform(X_val)

alphas = np.logspace(-3, 3, 13)
l1_val, l2_val, l1_coefs, l2_coefs = [], [], [], []
for a in alphas:
    lasso = Lasso(alpha=a, max_iter=50000).fit(Xf, y_fit)
    ridge = Ridge(alpha=a).fit(Xf, y_fit)
    l1_val.append(rmse(y_val, lasso.predict(Xv)))
    l2_val.append(rmse(y_val, ridge.predict(Xv)))
    l1_coefs.append(lasso.coef_)
    l2_coefs.append(ridge.coef_)

print(f"{'alpha':>10} {'L1 val RMSE':>14} {'L1 nonzero':>11} {'L2 val RMSE':>14}")
for i, a in enumerate(alphas):
    nz = int(np.sum(l1_coefs[i] != 0))
    print(f"{a:>10.3f} {l1_val[i]:>14.2f} {nz:>11d} {l2_val[i]:>14.2f}")

best_a1 = alphas[int(np.argmin(l1_val))]
best_a2 = alphas[int(np.argmin(l2_val))]
print("\nSelected alpha (validation RMSE): L1 =", round(best_a1, 4), " L2 =", round(best_a2, 4))

scaler_all = StandardScaler().fit(X_train)
Xtr, Xte = scaler_all.transform(X_train), scaler_all.transform(X_test)

models = {
    "Linear (no regularization)": LinearRegression(),
    f"L1 Lasso (alpha={best_a1:.3g})": Lasso(alpha=best_a1, max_iter=50000),
    f"L2 Ridge (alpha={best_a2:.3g})": Ridge(alpha=best_a2),
}

print(f"\n{'Model':<32} {'RMSE':>10} {'MAE':>10} {'R2':>8}")
fitted = {}
for name, m in models.items():
    m.fit(Xtr, y_train)
    pred = m.predict(Xte)
    fitted[name] = m
    print(f"{name:<32} {rmse(y_test, pred):>10.2f} {mean_absolute_error(y_test, pred):>10.2f} "
          f"{r2_score(y_test, pred):>8.4f}")

print(f"\n{'Feature':<20} {'Linear':>12} {'L1':>12} {'L2':>12}")
names = list(models.keys())
for j, f in enumerate(features):
    row = [fitted[nm].coef_[j] for nm in names]
    print(f"{f:<20} {row[0]:>12.2f} {row[1]:>12.2f} {row[2]:>12.2f}")

print("\nL1 zeroed features:", [f for j, f in enumerate(features) if fitted[names[1]].coef_[j] == 0])

fig, axes = plt.subplots(1, 2, figsize=(12, 4), sharey=True)
l1_arr, l2_arr = np.array(l1_coefs), np.array(l2_coefs)
for j, f in enumerate(features):
    axes[0].semilogx(alphas, l1_arr[:, j], label=f)
    axes[1].semilogx(alphas, l2_arr[:, j], label=f)
axes[0].set_title("L1 (Lasso): coefficient paths")
axes[1].set_title("L2 (Ridge): coefficient paths")
for ax in axes:
    ax.set_xlabel("alpha")
    ax.set_ylabel("Standardized coefficient")
    ax.grid(True)
axes[1].legend(loc="upper right", fontsize=8)
plt.tight_layout()
plt.show()
     
