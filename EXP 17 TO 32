# Program 30: Backpropagation for handwritten digit recognition

import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_digits
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

def sigmoid(z):
    return 1 / (1 + np.exp(-z))

def softmax(z):
    z = z - z.max(axis=1, keepdims=True)
    e = np.exp(z)
    return e / e.sum(axis=1, keepdims=True)

digits = load_digits()
X, y = digits.data, digits.target
Y = np.eye(10)[y]

X_train, X_test, Y_train, Y_test, y_train, y_test = train_test_split(
    X, Y, y, test_size=0.2, stratify=y, random_state=30)
scaler = StandardScaler().fit(X_train)
X_train, X_test = scaler.transform(X_train), scaler.transform(X_test)

rng = np.random.default_rng(30)
n_in, n_hidden, n_out = 64, 32, 10
W1 = rng.normal(0, np.sqrt(2 / n_in), (n_in, n_hidden))
b1 = np.zeros(n_hidden)
W2 = rng.normal(0, np.sqrt(2 / n_hidden), (n_hidden, n_out))
b2 = np.zeros(n_out)

def forward(X, W1, b1, W2, b2):
    z1 = X @ W1 + b1
    a1 = sigmoid(z1)
    z2 = a1 @ W2 + b2
    a2 = softmax(z2)
    return z1, a1, z2, a2

def loss_and_grads(X, Y, W1, b1, W2, b2):
    m = X.shape[0]
    z1, a1, z2, a2 = forward(X, W1, b1, W2, b2)
    loss = -np.sum(Y * np.log(a2 + 1e-12)) / m
    dz2 = (a2 - Y) / m
    dW2 = a1.T @ dz2
    db2 = dz2.sum(axis=0)
    da1 = dz2 @ W2.T
    dz1 = da1 * a1 * (1 - a1)
    dW1 = X.T @ dz1
    db1 = dz1.sum(axis=0)
    return loss, dW1, db1, dW2, db2

print("Gradient check (analytic vs numerical), small batch:")
Xs, Ys = X_train[:5], Y_train[:5]
_, gW1, gb1, gW2, gb2 = loss_and_grads(Xs, Ys, W1, b1, W2, b2)
eps = 1e-5
for name, param, grad in [("W2", W2, gW2), ("W1", W1, gW1)]:
    idx = (2, 3) if name == "W2" else (5, 7)
    orig = param[idx]
    param[idx] = orig + eps
    lp, *_ = loss_and_grads(Xs, Ys, W1, b1, W2, b2)
    param[idx] = orig - eps
    lm, *_ = loss_and_grads(Xs, Ys, W1, b1, W2, b2)
    param[idx] = orig
    numeric = (lp - lm) / (2 * eps)
    print(f"  {name}{idx}: analytic = {grad[idx]:.8f}, numerical = {numeric:.8f}")

lr = 0.5
epochs = 300
batch_size = 64
history = []
for epoch in range(epochs):
    order = rng.permutation(len(X_train))
    for start in range(0, len(order), batch_size):
        idx = order[start:start + batch_size]
        _, gW1, gb1, gW2, gb2 = loss_and_grads(X_train[idx], Y_train[idx], W1, b1, W2, b2)
        W1 -= lr * gW1; b1 -= lr * gb1
        W2 -= lr * gW2; b2 -= lr * gb2
    tr_loss, *_ = loss_and_grads(X_train, Y_train, W1, b1, W2, b2)
    history.append(tr_loss)

def accuracy(X, y):
    _, _, _, a2 = forward(X, W1, b1, W2, b2)
    return np.mean(np.argmax(a2, axis=1) == y)

print("\nTraining accuracy:", round(accuracy(X_train, y_train), 4))
print("Test accuracy:", round(accuracy(X_test, y_test), 4))
print("Final training loss:", round(history[-1], 4))

plt.figure(figsize=(7, 4))
plt.plot(history)
plt.xlabel("Epoch")
plt.ylabel("Cross-entropy loss")
plt.title("Backpropagation training on digits")
plt.grid(True)
plt.show()
     

# Program 31: Neural network house price prediction with MSE loss

import numpy as np
import matplotlib.pyplot as plt
from sklearn.neural_network import MLPRegressor
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score

rng = np.random.default_rng(31)
n = 800
area = rng.uniform(50, 250, n)
bedrooms = rng.integers(1, 6, n)
age = rng.uniform(0, 40, n)
location = rng.integers(1, 6, n)
price = (2500 * area + 18000 * bedrooms - 900 * age + 25000 * location
         + 0.002 * area ** 2 + rng.normal(0, 20000, n))

X = np.column_stack([area, bedrooms, age, location])
y = price

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=31)
X_fit, X_val, y_fit, y_val = train_test_split(X_train, y_train, test_size=0.25, random_state=31)

x_scaler = StandardScaler().fit(X_fit)
y_mean, y_std = y_fit.mean(), y_fit.std()

Xf = x_scaler.transform(X_fit)
Xv = x_scaler.transform(X_val)
Xte = x_scaler.transform(X_test)
yf = (y_fit - y_mean) / y_std

model = MLPRegressor(hidden_layer_sizes=(64, 32), activation="relu", solver="adam",
                     learning_rate_init=0.001, loss="squared_error", max_iter=2000,
                     early_stopping=True, validation_fraction=0.15, n_iter_no_change=30,
                     random_state=31)
model.fit(Xf, yf)

def to_price(z):
    return z * y_std + y_mean

pred_train = to_price(model.predict(Xf))
pred_val = to_price(model.predict(Xv))
pred_test = to_price(model.predict(Xte))

print("Training iterations run:", model.n_iter_)
print("\nError metrics (in price units):")
print(f"{'Split':<12} {'MSE':>18} {'RMSE':>12} {'MAE':>12} {'R2':>8}")
for name, yt, yp in [("Training", y_fit, pred_train),
                     ("Validation", y_val, pred_val),
                     ("Test", y_test, pred_test)]:
    mse = mean_squared_error(yt, yp)
    print(f"{name:<12} {mse:>18,.0f} {np.sqrt(mse):>12,.0f} "
          f"{mean_absolute_error(yt, yp):>12,.0f} {r2_score(yt, yp):>8.4f}")

errors = y_test - pred_test
print("\nTest residuals (actual - predicted):")
print(f"  Mean residual (bias): {errors.mean():,.0f}")
print(f"  Median absolute error: {np.median(np.abs(errors)):,.0f}")
print(f"  Largest over-prediction: {errors.min():,.0f}")
print(f"  Largest under-prediction: {errors.max():,.0f}")

print("\nError by price range (test set):")
bands = [(0, np.percentile(y_test, 33)),
         (np.percentile(y_test, 33), np.percentile(y_test, 66)),
         (np.percentile(y_test, 66), np.inf)]
labels = ["Low", "Middle", "High"]
for label, (lo, hi) in zip(labels, bands):
    mask = (y_test >= lo) & (y_test < hi)
    mae = mean_absolute_error(y_test[mask], pred_test[mask])
    pct = np.mean(np.abs(errors[mask]) / y_test[mask]) * 100
    print(f"  {label:<7} n={mask.sum():>3}  MAE={mae:>10,.0f}  mean % error={pct:>6.2f}%")

fig, axes = plt.subplots(1, 2, figsize=(12, 5))
axes[0].scatter(y_test, pred_test, alpha=0.6)
lims = [min(y_test.min(), pred_test.min()), max(y_test.max(), pred_test.max())]
axes[0].plot(lims, lims, "r--", label="Perfect prediction")
axes[0].set_xlabel("Actual price")
axes[0].set_ylabel("Predicted price")
axes[0].set_title("Actual vs predicted (test)")
axes[0].legend()
axes[0].grid(True)

axes[1].hist(errors, bins=30, edgecolor="black")
axes[1].axvline(0, color="red", linestyle="--")
axes[1].set_xlabel("Residual (actual - predicted)")
axes[1].set_ylabel("Count")
axes[1].set_title("Residual distribution (test)")
axes[1].grid(True)
plt.tight_layout()
plt.show()
     
