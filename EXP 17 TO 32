# Program 27: Sigmoid, tanh, and ReLU activation functions

import numpy as np
import matplotlib.pyplot as plt

def sigmoid(z):
    return 1 / (1 + np.exp(-z))

def sigmoid_derivative(z):
    s = sigmoid(z)
    return s * (1 - s)

def tanh(z):
    return (np.exp(z) - np.exp(-z)) / (np.exp(z) + np.exp(-z))

def tanh_derivative(z):
    return 1 - tanh(z) ** 2

def relu(z):
    return np.maximum(0, z)

def relu_derivative(z):
    return (z > 0).astype(float)

z = np.linspace(-6, 6, 400)

functions = {
    "Sigmoid": (sigmoid, sigmoid_derivative),
    "Tanh": (tanh, tanh_derivative),
    "ReLU": (relu, relu_derivative),
}

print(f"{'Function':<10} {'Min output':>12} {'Max output':>12} {'Output at z=0':>15} {'Max derivative':>16}")
for name, (f, df) in functions.items():
    out = f(z)
    print(f"{name:<10} {out.min():>12.4f} {out.max():>12.4f} {f(0.0):>15.4f} {df(z).max():>16.4f}")

print("\nDerivative at z = 5 (gradient strength for large positive input):")
for name, (f, df) in functions.items():
    print(f"{name:<10}: {df(5.0):.6f}")

print("\nDerivative at z = -5 (gradient strength for large negative input):")
for name, (f, df) in functions.items():
    print(f"{name:<10}: {df(-5.0):.6f}")

print("\nCheck against NumPy's tanh:", np.allclose(tanh(z), np.tanh(z)))

fig, axes = plt.subplots(2, 3, figsize=(14, 7))
for col, (name, (f, df)) in enumerate(functions.items()):
    axes[0, col].plot(z, f(z), color="blue")
    axes[0, col].set_title(f"{name} output")
    axes[0, col].set_xlabel("z")
    axes[0, col].grid(True)
    axes[1, col].plot(z, df(z), color="red")
    axes[1, col].set_title(f"{name} derivative")
    axes[1, col].set_xlabel("z")
    axes[1, col].grid(True)
plt.tight_layout()
plt.show()

print("\nAnalysis:")
print("Sigmoid squashes outputs into (0, 1); its derivative is at most 0.25, so gradients shrink in deep networks.")
print("Tanh squashes outputs into (-1, 1), is zero-centred, and its derivative is at most 1.")
print("ReLU is unbounded above, has derivative 1 for positive inputs, and derivative 0 for negative inputs.")
     

