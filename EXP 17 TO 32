# Program 25: Feedforward neural network solving the XOR problem

import numpy as np
import matplotlib.pyplot as plt

X = np.array([[0, 0],
              [0, 1],
              [1, 0],
              [1, 1]], dtype=float)
y = np.array([[0], [1], [1], [0]], dtype=float)

rng = np.random.default_rng(25)
W1 = rng.normal(0, 1, (2, 2))
b1 = np.zeros((1, 2))
W2 = rng.normal(0, 1, (2, 1))
b2 = np.zeros((1, 1))

def sigmoid(z):
    return 1 / (1 + np.exp(-z))

learning_rate = 1.0
epochs = 10000
losses = []

for epoch in range(epochs):
    h_in = X @ W1 + b1
    h = sigmoid(h_in)
    o_in = h @ W2 + b2
    o = sigmoid(o_in)

    loss = np.mean((o - y) ** 2)
    losses.append(loss)

    d_o = (o - y) * o * (1 - o)
    d_h = (d_o @ W2.T) * h * (1 - h)

    W2 -= learning_rate * (h.T @ d_o) / len(X)
    b2 -= learning_rate * np.mean(d_o, axis=0, keepdims=True)
    W1 -= learning_rate * (X.T @ d_h) / len(X)
    b1 -= learning_rate * np.mean(d_h, axis=0, keepdims=True)

final_out = sigmoid(sigmoid(X @ W1 + b1) @ W2 + b2)
predictions = (final_out >= 0.5).astype(int)

print("Hidden layer weights:\n", np.round(W1, 3))
print("Hidden layer biases:", np.round(b1, 3))
print("Output weights:\n", np.round(W2, 3))
print("Output bias:", np.round(b2, 3))

print("\n Input  Target  Output  Predicted")
for xi, t, o, p in zip(X, y, final_out, predictions):
    print(f"{xi[0]:.0f} {xi[1]:.0f}     {t[0]:.0f}      {o[0]:.4f}     {p[0]}")

print("\nAll four XOR cases correct:", np.array_equal(predictions, y.astype(int)))
print("Final mean squared error:", round(losses[-1], 6))

from sklearn.linear_model import Perceptron as SkPerceptron
sk = SkPerceptron(max_iter=1000, tol=None, random_state=0).fit(X, y.ravel())
print("\nSingle-layer perceptron accuracy on XOR:", round(sk.score(X, y.ravel()), 2))
print("(A single-layer perceptron cannot separate XOR, so it cannot reach 1.0.)")

plt.figure(figsize=(7, 4))
plt.plot(losses)
plt.yscale("log")
plt.xlabel("Epoch")
plt.ylabel("Mean squared error (log scale)")
plt.title("XOR training loss")
plt.grid(True)
plt.show()
     

