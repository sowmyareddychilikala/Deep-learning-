import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, confusion_matrix

rng = np.random.default_rng(24)
n = 300
income = rng.uniform(20, 150, n)
credit = rng.uniform(300, 850, n)

income_s = (income - income.mean()) / income.std()
credit_s = (credit - credit.mean()) / credit.std()
X = np.column_stack([income_s, credit_s])

eligible = (0.6 * income_s + 0.8 * credit_s + rng.normal(0, 0.3, n) > 0).astype(int)

X_train, X_test, y_train, y_test = train_test_split(X, eligible, test_size=0.25,
                                                    random_state=24, stratify=eligible)

class Perceptron:
    def __init__(self, learning_rate=0.1, epochs=100):
        self.lr = learning_rate
        self.epochs = epochs

    def predict(self, X):
        return (X @ self.w + self.b >= 0).astype(int)

    def fit(self, X, y):
        self.w = np.zeros(X.shape[1])
        self.b = 0.0
        self.mistakes = []
        for _ in range(self.epochs):
            errors = 0
            for xi, target in zip(X, y):
                update = self.lr * (target - self.predict(xi.reshape(1, -1))[0])
                if update != 0:
                    self.w += update * xi
                    self.b += update
                    errors += 1
            self.mistakes.append(errors)
            if errors == 0:
                break
        return self

model = Perceptron(learning_rate=0.1, epochs=100).fit(X_train, y_train)

print("Learned weights (income, credit):", np.round(model.w, 4))
print("Learned bias:", round(model.b, 4))
print("Epochs run:", len(model.mistakes))
print("Mistakes per epoch:", model.mistakes)
print("Converged (zero mistakes in final epoch):", model.mistakes[-1] == 0)

