# Program 18: Polynomial regression degrees and the bias-variance trade-off

import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error

rng = np.random.default_rng(3)
n = 120
area = rng.uniform(0.5, 3.0, n).reshape(-1, 1)
price = 40 * area.ravel() ** 2 - 25 * area.ravel() + 30 + rng.normal(0, 8, n)

X_train, X_test, y_train, y_test = train_test_split(area, price, test_size=0.3, random_state=3)
X_fit, X_val, y_fit, y_val = train_test_split(X_train, y_train, test_size=0.25, random_state=3)

degrees = list(range(1, 13))
fit_err, val_err = [], []
for d in degrees:
    poly = PolynomialFeatures(degree=d)
    X_f = poly.fit_transform(X_fit)
    X_v = poly.transform(X_val)
    model = LinearRegression().fit(X_f, y_fit)
    fit_err.append(mean_squared_error(y_fit, model.predict(X_f)))
    val_err.append(mean_squared_error(y_val, model.predict(X_v)))

print(f"{'Degree':>7} {'Fit MSE':>12} {'Validation MSE':>16}")
for d, fe, ve in zip(degrees, fit_err, val_err):
    print(f"{d:>7} {fe:>12.2f} {ve:>16.2f}")

best = degrees[int(np.argmin(val_err))]
print("\nBest degree (lowest validation error):", best)

poly_best = PolynomialFeatures(degree=best)
X_train_all = poly_best.fit_transform(X_train)
X_test_best = poly_best.transform(X_test)
final_model = LinearRegression().fit(X_train_all, y_train)
test_mse = mean_squared_error(y_test, final_model.predict(X_test_best))
print("Test MSE of selected degree:", round(test_mse, 2))

for d, fe, ve in zip(degrees, fit_err, val_err):
    if fe < min(fit_err) * 1.05 and ve > 2 * min(val_err):
        print("Degree", d, "onward: variance dominates (validation error more than doubles)")
        break

plt.plot(degrees, fit_err, marker="o", label="Fit MSE (training)")
plt.plot(degrees, val_err, marker="o", label="Validation MSE")
plt.xlabel("Polynomial degree")
plt.ylabel("Mean squared error")
plt.title("Bias-variance trade-off")
plt.legend()
plt.grid(True)
plt.yscale("log")
plt.show()
     
